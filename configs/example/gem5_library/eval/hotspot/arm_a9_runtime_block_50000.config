# arm_a9_runtime_block_50000.config
#
# Use with integrated runs using --power_interval 50000 --thermal_interval 50000.
# For 500000-cycle sampling see arm_a9_runtime_block_500000.config.
#
# Matches the current default runtime HotSpot setup as closely as possible:
#   - block model
#   - same package/spreader/heatsink/interface constants
#   - no secondary path
#   - interval = 50000 cycles at 2 GHz => 2.5e-05 s
#
# Note:
# The integrated runtime path currently starts thermal domains at 300.0 K,
# so init_temp is set to 300.0 here for closest comparison.

# --- active silicon layer ---
-t_chip              0.00015
-k_chip              100.0
-p_chip              1.75e6

# --- spreader ---
-s_spreader          0.03
-t_spreader          0.001
-k_spreader          400.0
-p_spreader          3.55e6

# --- heatsink ---
-s_sink              0.06
-t_sink              0.0069
-k_sink              400.0
-p_sink              3.55e6

# --- interface material ---
-t_interface         0.00002
-k_interface         4.0
-p_interface         4.0e6

# --- convection ---
-r_convec            0.1
-c_convec            140.4

# --- thermal operating point ---
-ambient             300.0
-init_temp           300.0

# --- model choices ---
-model_type          block
-model_secondary     0
-package_model_used  0
-leakage_used        0
-dtm_used            0
-block_omit_lateral  0

# --- sampling interval ---
-sampling_intvl      2.5e-05
-base_proc_freq      2.0e9
