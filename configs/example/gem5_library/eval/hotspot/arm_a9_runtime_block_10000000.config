# arm_a9_runtime_block_10000000.config
#
# Optional coarser sampling than 5000000 cycles: if traces are still too long,
# use with --power_interval 10000000 --thermal_interval 10000000 (2 GHz):
#   10000000 cycles / 2e9 Hz = 5.0e-3 s
#
# Same physics/package as arm_a9_runtime_block_5000000.config.

# --- active silicon layer ---
-t_chip              0.00015
-k_chip              100.0
-p_chip              1.75e6

# --- spreader ---
-s_spreader          0.03
-t_spreader          0.001
-k_spreader          400.0
-p_spreader          3.55e6

# --- heatsink ---
-s_sink              0.06
-t_sink              0.0069
-k_sink              400.0
-p_sink              3.55e6

# --- interface material ---
-t_interface         0.00002
-k_interface         4.0
-p_interface         4.0e6

# --- convection ---
-r_convec            0.1
-c_convec            140.4

# --- thermal operating point ---
-ambient             300.0
-init_temp           300.0

# --- model choices ---
-model_type          block
-model_secondary     0
-package_model_used  0
-leakage_used        0
-dtm_used            0
-block_omit_lateral  0

# --- sampling interval (10000000 cycles @ 2 GHz) ---
-sampling_intvl      5.0e-03
-base_proc_freq      2.0e9
